# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key (https://aistudio.google.com/apikey). Required for LLM_BACKEND=gemini.
GEMINI_API_KEY=

# Exact Gemma model id. Required. There is no default on purpose:
# run `python scripts/check_gemma.py` to list the ids your key can use.
GEMMA_MODEL=

# LLM backend: gemini (default) or ollama (experimental).
LLM_BACKEND=gemini

# Optional. Without it GitHub allows only 60 API calls per hour per IP.
GITHUB_TOKEN=

# Optional, ollama backend only. GEMMA_MODEL is then the Ollama model tag.
OLLAMA_HOST=http://localhost:11434

# Optional tuning.
# 1 = ask the backend for native JSON output. Off by default because Gemma may not support it.
BUGLENS_NATIVE_JSON=0
# Maximum number of code chunks indexed per repo.
BUGLENS_MAX_CHUNKS=8000
# "minimal" makes Gemma answer much faster (it skips most of its "thinking").
# Leave empty for the model's default. Not every model accepts this setting.
BUGLENS_THINKING_LEVEL=
